{# ===== Quick View Product Widget ===== #}
{# Fetched via: /products/{slug}?widgetKey=quick-view-product #}

{% set p = context.product %}
{% set hasDiscount = p.pricing and p.pricing.compareAtPrice and p.pricing.compareAtPrice > p.pricing.price %}
{% set discount = ((p.pricing.compareAtPrice - p.pricing.price) / p.pricing.compareAtPrice * 100) | round if hasDiscount else 0 %}
{% set canPurchase = p.allowBackorder or (not p.trackQuantity) or p.quantity > 0 %}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6" x-data="quickViewProduct()" x-init="init()">

  {# ——— Image Gallery ——— #}
  <div class="flex flex-col gap-3">
    <div class="relative overflow-hidden rounded-xl bg-secondary aspect-square">
      {% if p.images and p.images | length > 0 %}
        {% for image in p.images %}
          <img
            data-qv-img="{{ loop.index0 }}"
            src="{{ image.fileUrl }}"
            alt="{{ p.title }}"
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-300"
            :class="activeImage === {{ loop.index0 }} ? 'opacity-100' : 'opacity-0 pointer-events-none'"
            loading="lazy"
          />
        {% endfor %}
      {% else %}
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-16 h-16 text-tertiary" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      {% endif %}

      {# Discount Badge #}
      {% if hasDiscount %}
        <span class="absolute top-3 start-3 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-red-500 text-white z-10">
          -{{ discount }}%
        </span>
      {% endif %}
    </div>

    {# Thumbnails #}
    {% if p.images and p.images | length > 1 %}
      <div class="flex gap-2 overflow-x-auto pb-1">
        {% for image in p.images %}
          <button
            @click="activeImage = {{ loop.index0 }}"
            class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all duration-200"
            :class="activeImage === {{ loop.index0 }} ? 'border-accent' : 'border-transparent opacity-60'">
            <img src="{{ image.fileUrl }}" alt="" class="w-full h-full object-cover" loading="lazy"/>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {# ——— Product Info ——— #}
  <div class="flex flex-col gap-4">
    {# Title #}
    <h2 class="text-xl font-bold text-primary leading-tight">{{ p.title }}</h2>

    {# Rating #}
    {% if p.totalReviews > 0 %}
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-0.5">
          {% for i in range(5) %}
            <svg class="w-4 h-4 {% if i < p.averageRating %}text-warning{% else %}text-tertiary{% endif %}" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="text-[12px] text-tertiary">({{ p.totalReviews }})</span>
      </div>
    {% endif %}

    {# Price #}
    {% if p.pricing.price > 0 %}
      <div class="flex items-baseline gap-3">
        <span class="text-[22px] font-bold text-primary" x-text="currentPrice">{{ p.pricing.price | money }}</span>
        <template x-if="currentComparePrice">
          <span class="text-[14px] line-through text-tertiary" x-text="currentComparePrice">
            {% if hasDiscount %}{{ p.pricing.compareAtPrice | money }}{% endif %}
          </span>
        </template>
        <template x-if="discountPercent > 0">
          <span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-red-500 text-white" x-text="'-' + discountPercent + '%'">
            {% if hasDiscount %}-{{ discount }}%{% endif %}
          </span>
        </template>
      </div>
    {% endif %}

    <hr class="border-0 h-px" style="background: var(--color-border);"/>

    {# Variant Options #}
    {% if p.options and p.options | length > 0 %}
      <div class="flex flex-col gap-4">
        {% for option in p.options %}
          <div class="flex flex-col gap-2">
            <span class="text-[13px] font-medium uppercase tracking-[0.06em] text-secondary">
              {{ option.name }}
            </span>

            {% if option.type == 'color' %}
              <div class="flex flex-wrap gap-2">
                {% for value in option.values %}
                  <button
                    @click="selectOption('{{ option.name }}', '{{ value._id }}', '{{ value.label }}')"
                    class="w-8 h-8 rounded-full border-2 transition-all duration-200"
                    :class="selectedOptions['{{ option.name }}'] === '{{ value._id }}' ? 'border-accent scale-110' : 'border-transparent'"
                    style="background: {{ value.value | default('#ccc') }}; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.3);"
                    aria-label="{{ value.label }}">
                  </button>
                {% endfor %}
              </div>
            {% else %}
              <div class="flex flex-wrap gap-2">
                {% for value in option.values %}
                  <button
                    @click="selectOption('{{ option.name }}', '{{ value._id }}', '{{ value.label }}')"
                    class="px-3 py-1.5 rounded-lg text-[13px] border transition-all duration-200"
                    :class="selectedOptions['{{ option.name }}'] === '{{ value._id }}' ? 'border-accent bg-accent text-white' : 'text-secondary'"
                    :style="selectedOptions['{{ option.name }}'] !== '{{ value._id }}' ? 'border-color: var(--color-border)' : ''">
                    {{ value.label }}
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <hr class="border-0 h-px" style="background: var(--color-border);"/>
    {% endif %}

    {# Stock Status #}
    <div class="flex items-center gap-2 text-sm">
      <template x-if="!isOutOfStock">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
          <span class="text-green-600 font-medium text-xs">{{t('pages.product.in_stock')}}</span>
        </div>
      </template>
      <template x-if="isOutOfStock">
        <div class="flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
          <span class="text-red-600 font-medium text-xs">{{t('pages.product.out_of_stock')}}</span>
        </div>
      </template>
    </div>

    {# Description (truncated) #}
    {% if p.description %}
      <div class="text-[13px] leading-relaxed text-secondary line-clamp-3">
        {{ p.description | striptags | truncate(200) }}
      </div>
    {% endif %}

    {# Quantity + Add to Cart #}
    <div class="flex items-center gap-3 mt-auto">
      {# Quantity #}
      <div class="flex items-center border border-gray-200 rounded-xl shrink-0">
        <button type="button" @click="qty > 1 && qty--" :disabled="qty <= 1"
                class="w-9 h-9 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors disabled:opacity-30">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/></svg>
        </button>
        <span class="w-9 h-9 flex items-center justify-center text-sm font-bold border-x border-gray-200" x-text="qty">1</span>
        <button type="button" @click="qty < 99 && qty++"
                class="w-9 h-9 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
        </button>
      </div>

      {# Add to Cart #}
      <button type="button" @click="addToCart()" :disabled="isOutOfStock || addingToCart"
              class="flex-1 h-9 rounded-xl font-semibold text-sm transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
              :class="addedSuccess ? 'bg-green-500 text-white' : 'bg-accent text-white hover:bg-accent-hover'">
        <template x-if="addingToCart">
          <span class="flex items-center justify-center gap-2">
            <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
          </span>
        </template>
        <template x-if="addedSuccess && !addingToCart">
          <span class="flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            {{t('pages.product.added')}}
          </span>
        </template>
        <template x-if="!addingToCart && !addedSuccess">
          <span class="flex items-center justify-center gap-2">
            {{t('pages.product.add_to_cart')}}
          </span>
        </template>
      </button>
    </div>

    {# View Full Product Link #}
    <a href="/product/{{ p.slug }}"
       @click="$store.modal.close()"
       class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:opacity-80 transition-colors">
      {{t('pages.product.view_full_details')}}
      <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>
</div>

<script>
  window.quickViewProduct = function() {
    return {
      qty: 1,
      activeImage: 0,
      addingToCart: false,
      addedSuccess: false,
      selectedOptions: {},
      selectedLabels: {},
      currentVariantId: null,
      currentPrice: '{{ p.pricing.price | money }}',
      currentComparePrice: {% if hasDiscount %}'{{ p.pricing.compareAtPrice | money }}'{% else %}null{% endif %},
      discountPercent: {% if hasDiscount %}{{ discount }}{% else %}0{% endif %},
      isOutOfStock: {{ 'true' if not canPurchase else 'false' }},

      variants: [
        {% for variant in p.variants %}
        {
          id: '{{ variant._id }}',
          price: {{ variant.pricing.price | default(0) }},
          priceFormatted: '{{ variant.pricing.price | money }}',
          compareAtPrice: {{ variant.pricing.compareAtPrice | default(0) }},
          compareAtPriceFormatted: '{{ variant.pricing.compareAtPrice | money }}',
          quantity: {{ variant.quantity | default(0) }},
          trackQuantity: {{ 'true' if variant.trackQuantity else 'false' }},
          allowBackorder: {{ 'true' if variant.allowBackorder else 'false' }},
          options: {{ variant.options | dump | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],

      init() {
        {% for option in p.options %}
          {% if option.values | length > 0 %}
            this.selectedOptions['{{ option.name }}'] = '{{ option.values[0]._id }}';
            this.selectedLabels['{{ option.name }}'] = '{{ option.values[0].label }}';
          {% endif %}
        {% endfor %}

        {% if p.options | length > 0 %}
          this.matchVariant();
        {% endif %}
      },

      selectOption(name, valueId, label) {
        this.selectedOptions[name] = valueId;
        this.selectedLabels[name] = label;
        this.matchVariant();
      },

      matchVariant() {
        var selectedIds = Object.values(this.selectedOptions);
        var matched = this.variants.find(function(v) {
          if (!v.options || !v.options.length) return false;
          if (v.options.length !== selectedIds.length) return false;
          for (var i = 0; i < selectedIds.length; i++) {
            if (v.options.indexOf(selectedIds[i]) === -1) return false;
          }
          return true;
        });

        if (matched) {
          this.currentVariantId = matched.id;
          this.currentPrice = matched.priceFormatted;

          if (matched.trackQuantity && !matched.allowBackorder) {
            this.isOutOfStock = matched.quantity <= 0;
          } else {
            this.isOutOfStock = false;
          }

          if (matched.compareAtPrice && matched.compareAtPrice > matched.price) {
            this.currentComparePrice = matched.compareAtPriceFormatted;
            this.discountPercent = Math.round(((matched.compareAtPrice - matched.price) / matched.compareAtPrice) * 100);
          } else {
            this.currentComparePrice = null;
            this.discountPercent = 0;
          }
        }
      },

      async addToCart() {
        if (this.isOutOfStock || this.addingToCart) return;
        this.addingToCart = true;
        try {
          var optionIds = Object.values(this.selectedOptions);
          await Qumra.cart.add('{{ p._id }}', this.qty, optionIds.length ? optionIds : null);
          this.addedSuccess = true;
          setTimeout(() => { this.addedSuccess = false; }, 2000);
        } catch (err) {
          console.error('Quick view add to cart error:', err);
        } finally {
          this.addingToCart = false;
        }
      }
    };
  };
</script>
