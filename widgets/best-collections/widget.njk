{# ===== SUKOON Best Collections Widget (Builder) ===== #}
{% set collections = widget.data.collections %}

<section id="{{ widget.id }}" class="py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    {% if collections and (collections | length) %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for collection in collections %}
          <a href="/collections/{{ collection.slug }}"
             class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500 reveal"
             style="transition-delay: {{ loop.index0 * 80 }}ms;">

            {# Image #}
            {% if collection.image and collection.image.fileUrl %}
              <div class="aspect-[16/10] overflow-hidden bg-gray-50">
                <img src="{{ collection.image.fileUrl }}"
                     alt="{{ collection.title }}"
                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                     loading="lazy">
              </div>
            {% else %}
              <div class="aspect-[16/10] bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center">
                <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"/>
                </svg>
              </div>
            {% endif %}

            {# Content #}
            <div class="p-5">
              <h3 class="text-base font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">
                {{ collection.title }}
              </h3>
              {% if collection.description %}
                <p class="text-sm text-tertiary leading-relaxed line-clamp-2 mb-3">
                  {{ collection.description | striptags | truncate(100, true, '...') }}
                </p>
              {% endif %}
              <div class="flex items-center justify-between">
                {% if collection.productCount is defined %}
                  <span class="text-xs text-tertiary">
                    {{ collection.productCount | default(0) }} {{ t('blocks.categories.products_count') | default('منتج') }}
                  </span>
                {% endif %}
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary group-hover:gap-2 transition-all ms-auto">
                  {{ t('common.view_all') | default('عرض الكل') }}
                  <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>

    {% else %}
      {# Empty State #}
      <div class="text-center py-16 reveal">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-50 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"/>
          </svg>
        </div>
        <p class="text-sm text-tertiary">{{ t('blocks.categories.no_categories') | default('لا توجد تصنيفات بعد') }}</p>
      </div>
    {% endif %}

  </div>
</section>
