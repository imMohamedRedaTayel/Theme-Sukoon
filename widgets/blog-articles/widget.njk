{# ===== SUKOON Blog Articles Widget (Builder — Homepage/Any Page) ===== #}
{% set articles = widget.data.articles %}
{% set title = widget.data.title | default('') %}
{% set subtitle = widget.data.subtitle | default('') %}
{% set cols = widget.data.columns | default('3') %}
{% set displayLayout = widget.data.display_layout | default('grid') %}
{% set showDate = widget.data.show_date | default(true) %}
{% set showExcerpt = widget.data.show_excerpt | default(true) %}
{% set id = widget.id %}

{# Column grid classes #}
{% if cols == '2' %}
  {% set gridClass = 'grid-cols-1 sm:grid-cols-2' %}
{% elif cols == '4' %}
  {% set gridClass = 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4' %}
{% else %}
  {% set gridClass = 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' %}
{% endif %}

<section id="{{ id }}" class="py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    {# ── Section Header ── #}
    {% if title or subtitle %}
      <div class="text-center mb-12 reveal">
        {% if title %}
          <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-3">{{ title }}</h2>
        {% endif %}
        {% if subtitle %}
          <p class="text-tertiary text-base max-w-lg mx-auto leading-relaxed">{{ subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {# ── Articles ── #}
    {% if articles and (articles | length) %}

      {% if displayLayout == 'slider' %}
        {# ── Slider Layout ── #}
        <div class="reveal">
          <div class="swiper" id="swiper-{{ id }}">
            <div class="swiper-wrapper" style="padding-bottom: 4px;">
              {% for article in articles %}
                <div class="swiper-slide" style="height: auto;">
                  {% include "ui/article-card.njk" %}
                </div>
              {% endfor %}
            </div>
          </div>

          {# Navigation #}
          <div class="flex items-center justify-center gap-6 mt-10">
            <button id="prev-{{ id }}" aria-label="Previous"
                    class="group w-11 h-11 rounded-full flex items-center justify-center transition-all duration-300"
                    style="border: 1.5px solid var(--color-border); background: transparent;">
              <svg class="w-4 h-4 rtl:rotate-180 transition-transform duration-300 group-hover:-translate-x-0.5 rtl:group-hover:translate-x-0.5"
                   style="color: var(--color-text-secondary);" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div id="dots-{{ id }}" class="flex items-center gap-2"></div>
            <button id="next-{{ id }}" aria-label="Next"
                    class="group w-11 h-11 rounded-full flex items-center justify-center transition-all duration-300"
                    style="border: 1.5px solid var(--color-border); background: transparent;">
              <svg class="w-4 h-4 rtl:rotate-180 transition-transform duration-300 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5"
                   style="color: var(--color-text-secondary);" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>

        <style>
          #prev-{{ id }}:hover, #next-{{ id }}:hover { border-color: var(--color-accent); background: var(--color-accent); }
          #prev-{{ id }}:hover svg, #next-{{ id }}:hover svg { color: #fff; }
          #dots-{{ id }} .dot { width: 24px; height: 3px; border-radius: 9999px; background: var(--color-border); transition: all 400ms ease; cursor: pointer; }
          #dots-{{ id }} .dot.active { width: 40px; background: var(--color-accent); }
        </style>

        <script>
          (() => {
            var cols = {{ cols }};
            var swiper = new Swiper('#swiper-{{ id }}', {
              slidesPerView: 1,
              spaceBetween: 20,
              grabCursor: true,
              loop: {{ articles | length }} > cols,
              navigation: { prevEl: '#prev-{{ id }}', nextEl: '#next-{{ id }}' },
              breakpoints: {
                640: { slidesPerView: 2, spaceBetween: 20 },
                1024: { slidesPerView: Math.min(cols, 3), spaceBetween: 24 },
                1280: { slidesPerView: cols, spaceBetween: 24 }
              }
            });

            var dotsC = document.getElementById('dots-{{ id }}');
            var total = {{ articles | length }};
            var pv = window.innerWidth >= 1280 ? cols : window.innerWidth >= 1024 ? Math.min(cols, 3) : window.innerWidth >= 640 ? 2 : 1;
            var dc = Math.max(total - pv + 1, 1);
            for (var i = 0; i < dc; i++) {
              var d = document.createElement('span');
              d.className = 'dot' + (i === 0 ? ' active' : '');
              d.dataset.index = i;
              d.addEventListener('click', function () { swiper.slideTo(parseInt(this.dataset.index)); });
              dotsC.appendChild(d);
            }
            swiper.on('slideChange', function () {
              var dots = dotsC.querySelectorAll('.dot');
              var idx = swiper.realIndex % dc;
              dots.forEach(function (dd, j) { dd.classList.toggle('active', j === idx); });
            });
          })();
        </script>

      {% else %}
        {# ── Grid Layout ── #}
        <div class="grid {{ gridClass }} gap-6">
          {% for article in articles %}
            <div class="reveal" style="transition-delay: {{ loop.index0 * 80 }}ms;">
              {% include "ui/article-card.njk" %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

    {% else %}
      {# ── Empty State ── #}
      <div class="text-center py-16 reveal">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-50 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
        </div>
        <p class="text-sm text-tertiary">{{ t('pages.blog.no_articles') | default('لا توجد مقالات بعد') }}</p>
      </div>
    {% endif %}

  </div>
</section>
