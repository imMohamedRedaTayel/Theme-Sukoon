{# ===== SUKOON Best Product Widget (Builder) ===== #}
{% set product = widget.data.product %}

{% if product %}
<section id="{{ widget.id }}" class="py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="reveal">
      <a href="/products/{{ product.slug }}"
         class="group flex flex-col sm:flex-row gap-6 bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500 p-5">

        {# Image #}
        <div class="sm:w-56 sm:min-w-[224px] aspect-square rounded-xl overflow-hidden bg-gray-50 flex-shrink-0">
          {% if product.images and (product.images | length) %}
            <img src="{{ product.images[0].fileUrl }}"
                 alt="{{ product.title }}"
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                 loading="lazy">
          {% else %}
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-12 h-12 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a2.25 2.25 0 002.25-2.25V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z"/>
              </svg>
            </div>
          {% endif %}
        </div>

        {# Content #}
        <div class="flex flex-col justify-center flex-1 min-w-0">
          <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors line-clamp-2">
            {{ product.title }}
          </h3>

          {% if product.description %}
            <p class="text-sm text-tertiary leading-relaxed line-clamp-2 mb-4">
              {{ product.description | striptags | truncate(150, true, '...') }}
            </p>
          {% endif %}

          {# Price #}
          <div class="flex items-center gap-3 mb-4">
            {% if product.pricing and product.pricing.price %}
              <span class="text-lg font-bold text-text-primary">{{ product.pricing.price | money }}</span>
              {% if product.pricing.compareAtPrice and product.pricing.compareAtPrice > product.pricing.price %}
                <span class="text-sm text-tertiary line-through">{{ product.pricing.compareAtPrice | money }}</span>
                {% set discount = (((product.pricing.compareAtPrice - product.pricing.price) / product.pricing.compareAtPrice) * 100) | round %}
                <span class="text-xs font-semibold text-green-600 bg-green-50 px-2 py-0.5 rounded-full">-{{ discount }}%</span>
              {% endif %}
            {% endif %}
          </div>

          {# CTA #}
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-primary group-hover:gap-3 transition-all">
            {{ t('pages.product.view_full_details') | default('عرض تفاصيل المنتج') }}
            <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</section>
{% endif %}
