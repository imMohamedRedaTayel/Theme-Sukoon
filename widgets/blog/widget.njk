{# ===== SUKOON Single Blog Widget (Builder) ===== #}
{% set article = widget.data.articles %}

{% if article %}
  <section id="{{ widget.id }}" class="py-8">
    <div class="max-w-md mx-auto px-4">
      <a href="/article/{{ article.slug }}"
         class="group block bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500">

        {% if article.image and article.image.fileUrl %}
          <div class="aspect-[16/10] overflow-hidden bg-gray-50">
            <img src="{{ article.image.fileUrl }}"
                 alt="{{ article.title }}"
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                 loading="lazy">
          </div>
        {% endif %}

        <div class="p-5">
          <h3 class="text-lg font-bold text-text-primary mb-2 group-hover:text-primary transition-colors">
            {{ article.title }}
          </h3>
          {% if article.createdAt %}
            <p class="text-xs text-tertiary mb-3">{{ article.createdAt }}</p>
          {% endif %}
          <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary group-hover:gap-2 transition-all">
            {{ t('pages.blog.read_more') | default('اقرأ المزيد') }}
            <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
  </section>
{% else %}
  <div class="text-center py-12">
    <p class="text-sm text-tertiary">{{ t('pages.blog.no_articles') | default('لا توجد مقالات') }}</p>
  </div>
{% endif %}
