{# ===== SUKOON Article Page — /article/{handle} ===== #}
{% set article = context.article | default({}) %}
{% set showShare = widget.data.show_share | default(true) %}
{% set showRelated = widget.data.show_related | default(true) %}
{% set relatedArticles = article.relatedArticles | default(article.related | default([])) %}

<section id="{{ widget.id }}" class="py-10 md:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">

    {# ── Breadcrumbs ── #}
    <nav class="flex items-center gap-2 text-[13px] text-tertiary mb-8 flex-wrap">
      <a href="/" class="hover:text-primary transition-colors">{{ t('common.home') }}</a>
      <svg class="w-3 h-3 opacity-40 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <a href="/blogs" class="hover:text-primary transition-colors">{{ t('pages.blog.title') | default('المدونة') }}</a>
      {% if article.blog %}
        <svg class="w-3 h-3 opacity-40 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/blogs/{{ article.blog.handle | default(article.blog.slug) }}" class="hover:text-primary transition-colors">{{ article.blog.title }}</a>
      {% endif %}
      <svg class="w-3 h-3 opacity-40 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-text-primary font-medium line-clamp-1 max-w-[200px]">{{ article.title | default('') }}</span>
    </nav>

    {# ── Hero Image ── #}
    {% if article.image and article.image.fileUrl %}
      <div class="rounded-2xl overflow-hidden mb-8 bg-gray-50">
        <img src="{{ article.image.fileUrl }}"
             alt="{{ article.title }}"
             class="w-full h-auto max-h-[480px] object-cover"
             loading="eager">
      </div>
    {% endif %}

    {# ── Article Header ── #}
    <header class="mb-8">
      {# Category Badge #}
      {% if article.category %}
        <span class="inline-block text-xs font-semibold text-primary bg-primary/10 px-3 py-1 rounded-full mb-4">
          {{ article.category.title }}
        </span>
      {% endif %}

      {# Title #}
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-text-primary leading-tight mb-5">
        {{ article.title | default('') }}
      </h1>

      {# Meta Info #}
      <div class="flex items-center flex-wrap gap-4 text-sm text-tertiary">
        {% if article.author %}
          <div class="flex items-center gap-2">
            {% if article.author.avatar and article.author.avatar.fileUrl %}
              <img src="{{ article.author.avatar.fileUrl }}" alt="{{ article.author.name }}"
                   class="w-8 h-8 rounded-full object-cover border border-gray-100">
            {% else %}
              <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                </svg>
              </div>
            {% endif %}
            <span class="font-medium text-text-primary">{{ article.author.name }}</span>
          </div>
          <span class="text-gray-200">|</span>
        {% endif %}

        {% if article.createdAt %}
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
            </svg>
            {{ article.createdAt }}
          </span>
        {% endif %}

        {% if article.views is defined %}
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {{ article.views }} {{ t('pages.blog.views') | default('مشاهدة') }}
          </span>
        {% endif %}
      </div>
    </header>

    <div class="border-t border-gray-100 mb-8"></div>

    {# ── Article Content ── #}
    <article class="sukoon-article-content text-text-primary leading-[1.9] text-[16px]">
      {{ article.content | safe }}
    </article>

    {# ── Tags ── #}
    {% if article.tags and (article.tags | length) %}
      <div class="mt-8 flex items-center flex-wrap gap-2">
        <svg class="w-4 h-4 text-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/>
        </svg>
        {% for tag in article.tags %}
          <span class="text-xs bg-gray-50 text-tertiary px-3 py-1 rounded-full border border-gray-100">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {# ── Share ── #}
    {% if showShare %}
      <div class="mt-8 pt-6 border-t border-gray-100" x-data="{ copied: false }">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <span class="text-sm font-semibold text-text-primary">{{ t('pages.blog.share_article') | default('شارك المقال') }}</span>
          <div class="flex items-center gap-2">
            {# Twitter/X #}
            <a href="https://twitter.com/intent/tweet?url={{ page.url | default('') }}&text={{ article.title | default('') }}"
               target="_blank" rel="noopener"
               class="w-9 h-9 rounded-full bg-gray-50 hover:bg-gray-100 flex items-center justify-center text-tertiary hover:text-text-primary transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            {# WhatsApp #}
            <a href="https://wa.me/?text={{ article.title | default('') }}%20{{ page.url | default('') }}"
               target="_blank" rel="noopener"
               class="w-9 h-9 rounded-full bg-gray-50 hover:bg-green-50 flex items-center justify-center text-tertiary hover:text-green-600 transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
            {# Copy Link #}
            <button @click="navigator.clipboard.writeText(window.location.href); copied = true; setTimeout(() => copied = false, 2000)"
                    class="w-9 h-9 rounded-full bg-gray-50 hover:bg-gray-100 flex items-center justify-center text-tertiary hover:text-text-primary transition-colors relative">
              <svg x-show="!copied" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
              </svg>
              <svg x-show="copied" x-cloak class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    {% endif %}

    {# ── Back Link ── #}
    <div class="mt-8 pt-6 border-t border-gray-100">
      <a href="{% if article.blog %}/blogs/{{ article.blog.handle | default(article.blog.slug) }}{% else %}/blogs{% endif %}"
         class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:gap-3 transition-all">
        <svg class="w-4 h-4 rtl:rotate-180 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
        {{ t('pages.blog.back_to_articles') | default('العودة للمقالات') }}
      </a>
    </div>

  </div>

  {# ── Related Articles ── #}
  {% if showRelated and relatedArticles and (relatedArticles | length) %}
    <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-16">
      <div class="border-t border-gray-100 pt-12">
        <h2 class="text-xl font-bold text-text-primary mb-6">{{ t('pages.blog.related_articles') | default('مقالات ذات صلة') }}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {% for related in relatedArticles %}
            {% if loop.index <= 3 %}
              <a href="/article/{{ related.slug }}"
                 class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500 flex flex-col">
                {% if related.image and related.image.fileUrl %}
                  <div class="aspect-[16/10] overflow-hidden bg-gray-50">
                    <img src="{{ related.image.fileUrl }}"
                         alt="{{ related.title }}"
                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                         loading="lazy">
                  </div>
                {% else %}
                  <div class="aspect-[16/10] bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center">
                    <svg class="w-10 h-10 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="p-5">
                  <h3 class="text-sm font-bold text-text-primary mb-2 line-clamp-2 group-hover:text-primary transition-colors">
                    {{ related.title }}
                  </h3>
                  {% if related.createdAt %}
                    <span class="text-[11px] text-tertiary">{{ related.createdAt }}</span>
                  {% endif %}
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}
</section>

{# ── Article Content Styling ── #}
<style>
  .sukoon-article-content h1,
  .sukoon-article-content h2,
  .sukoon-article-content h3,
  .sukoon-article-content h4 {
    font-weight: 700;
    margin-top: 2em;
    margin-bottom: 0.75em;
    line-height: 1.4;
  }
  .sukoon-article-content h2 { font-size: 1.5em; }
  .sukoon-article-content h3 { font-size: 1.25em; }
  .sukoon-article-content h4 { font-size: 1.1em; }
  .sukoon-article-content p {
    margin-bottom: 1.25em;
  }
  .sukoon-article-content img {
    border-radius: 12px;
    margin: 1.5em 0;
    max-width: 100%;
    height: auto;
  }
  .sukoon-article-content ul,
  .sukoon-article-content ol {
    padding-inline-start: 1.5em;
    margin-bottom: 1.25em;
  }
  .sukoon-article-content li {
    margin-bottom: 0.5em;
  }
  .sukoon-article-content blockquote {
    border-inline-start: 3px solid var(--color-primary, #00BCD4);
    padding: 1em 1.5em;
    margin: 1.5em 0;
    background: var(--color-bg-primary, #F8FAFB);
    border-radius: 0 12px 12px 0;
    font-style: italic;
    color: var(--color-text-secondary, #546E7A);
  }
  [dir="rtl"] .sukoon-article-content blockquote {
    border-radius: 12px 0 0 12px;
  }
  .sukoon-article-content a {
    color: var(--color-primary, #00BCD4);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sukoon-article-content a:hover {
    opacity: 0.8;
  }
  .sukoon-article-content pre {
    background: #1f2937;
    color: #e5e7eb;
    padding: 1.25em;
    border-radius: 12px;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.9em;
    line-height: 1.6;
  }
  .sukoon-article-content code {
    background: var(--color-bg-primary, #F8FAFB);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }
  .sukoon-article-content pre code {
    background: none;
    padding: 0;
  }
  .sukoon-article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    border-radius: 12px;
    overflow: hidden;
  }
  .sukoon-article-content th,
  .sukoon-article-content td {
    padding: 0.75em 1em;
    border: 1px solid var(--color-border, #D4DFE2);
    text-align: start;
  }
  .sukoon-article-content th {
    background: var(--color-bg-primary, #F8FAFB);
    font-weight: 600;
  }
  .sukoon-article-content hr {
    border: none;
    border-top: 1px solid var(--color-border, #D4DFE2);
    margin: 2em 0;
  }
</style>
