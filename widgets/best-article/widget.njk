{# ===== SUKOON Best Article Widget (Builder) ===== #}
{% set article = widget.data.article %}

{% if article %}
  <section id="{{ widget.id }}" class="py-10 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <a href="/article/{{ article.slug }}"
         class="group block bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500 md:flex">

        {# Image (large featured) #}
        {% if article.image and article.image.fileUrl %}
          <div class="md:w-1/2 aspect-[16/10] md:aspect-auto overflow-hidden bg-gray-50">
            <img src="{{ article.image.fileUrl }}"
                 alt="{{ article.title }}"
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                 loading="lazy">
          </div>
        {% endif %}

        {# Content #}
        <div class="p-6 md:p-8 flex flex-col justify-center {% if article.image and article.image.fileUrl %}md:w-1/2{% endif %}">
          {% if article.category %}
            <span class="inline-block text-xs font-semibold text-primary bg-primary/10 px-3 py-1 rounded-full mb-4 w-fit">
              {{ article.category.title }}
            </span>
          {% endif %}

          <h2 class="text-xl md:text-2xl font-bold text-text-primary mb-3 group-hover:text-primary transition-colors leading-snug">
            {{ article.title }}
          </h2>

          <p class="text-sm text-tertiary leading-relaxed line-clamp-3 mb-5">
            {{ article.content | striptags | truncate(200, true, '...') }}
          </p>

          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 text-[11px] text-tertiary">
              {% if article.createdAt %}
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                  </svg>
                  {{ article.createdAt }}
                </span>
              {% endif %}
              {% if article.views is defined %}
                <span>{{ article.views }} {{ t('pages.blog.views') | default('مشاهدة') }}</span>
              {% endif %}
            </div>
            <span class="text-xs font-semibold text-primary flex items-center gap-1 group-hover:gap-2 transition-all">
              {{ t('pages.blog.read_more') | default('اقرأ المزيد') }}
              <svg class="w-3.5 h-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </div>
        </div>
      </a>
    </div>
  </section>
{% else %}
  <div class="text-center py-12">
    <p class="text-sm text-tertiary">{{ t('pages.blog.no_articles') | default('لا توجد مقالات') }}</p>
  </div>
{% endif %}
