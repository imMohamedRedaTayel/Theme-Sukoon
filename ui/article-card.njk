{# ===== SUKOON Article Card (shared partial) ===== #}
{# Expects: article, showDate (default true), showExcerpt (default true) #}
{% set _showDate = showDate if showDate is defined else true %}
{% set _showExcerpt = showExcerpt if showExcerpt is defined else true %}

<a href="/article/{{ article.slug }}"
   class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-500 flex flex-col h-full">

  {# Image #}
  {% if article.image and article.image.fileUrl %}
    <div class="aspect-[16/10] overflow-hidden bg-gray-50 relative">
      <img src="{{ article.image.fileUrl }}"
           alt="{{ article.title }}"
           class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
           loading="lazy">
      {% if article.category %}
        <span class="absolute top-3 start-3 bg-white/90 backdrop-blur-sm text-[11px] font-semibold text-primary px-2.5 py-1 rounded-full">
          {{ article.category.title }}
        </span>
      {% endif %}
    </div>
  {% else %}
    <div class="aspect-[16/10] bg-gradient-to-br from-gray-50 to-gray-100 flex items-center justify-center relative">
      <svg class="w-10 h-10 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
      </svg>
      {% if article.category %}
        <span class="absolute top-3 start-3 bg-white/90 backdrop-blur-sm text-[11px] font-semibold text-primary px-2.5 py-1 rounded-full">
          {{ article.category.title }}
        </span>
      {% endif %}
    </div>
  {% endif %}

  {# Content #}
  <div class="p-5 flex flex-col flex-1">
    <h3 class="text-[15px] font-bold text-text-primary mb-2 line-clamp-2 group-hover:text-primary transition-colors leading-snug">
      {{ article.title }}
    </h3>

    {% if _showExcerpt and article.content %}
      <p class="text-sm text-tertiary leading-relaxed line-clamp-2 mb-4 flex-1">
        {{ article.content | striptags | truncate(120, true, '...') }}
      </p>
    {% endif %}

    {# Footer #}
    <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-50">
      <div class="flex items-center gap-3 text-[11px] text-tertiary">
        {% if _showDate and article.createdAt %}
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
            </svg>
            {{ article.createdAt }}
          </span>
        {% endif %}
        {% if article.views is defined %}
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.64 0 8.577 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.64 0-8.577-3.007-9.963-7.178z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {{ article.views }}
          </span>
        {% endif %}
      </div>
      <span class="text-[11px] font-semibold text-primary flex items-center gap-1 group-hover:gap-1.5 transition-all">
        {{ t('pages.blog.read_more') | default('اقرأ المزيد') }}
        <svg class="w-3 h-3 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </span>
    </div>
  </div>
</a>
