{# Search Modal #}
<div x-data x-cloak>
  {# Overlay #}
  <div x-show="$store.modal.current === 'search'"
       @click="$store.modal.close()"
       class="overlay"
       x-transition:enter="transition ease-out duration-400"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave="transition ease-in duration-300"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0">
  </div>

  {# Search Panel #}
  <div x-show="$store.modal.current === 'search'"
       x-transition:enter="transition ease-out duration-400"
       x-transition:enter-start="opacity-0 -translate-y-4"
       x-transition:enter-end="opacity-100 translate-y-0"
       x-transition:leave="transition ease-in duration-300"
       x-transition:leave-start="opacity-100 translate-y-0"
       x-transition:leave-end="opacity-0 -translate-y-4"
       class="fixed top-0 inset-x-0 z-50 shadow-xl max-h-[85vh] overflow-y-auto" style="background: var(--color-surface);"
       x-data="{ query: '', products: [], queries: [], searching: false }">

    <div class="container mx-auto px-6 max-sm:px-4 py-5">

      {# Search Input #}
      <form action="/shop" method="get" class="flex items-center gap-3 pb-4" style="border-bottom: 1px solid var(--color-border);">
        <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input type="text"
               name="q"
               x-model="query"
               @input.debounce.300ms="if(query.length >= 2) { searching = true; Qumra.search.suggest(query, (data) => { products = (data.resources && data.resources.products) || data.products || []; queries = (data.resources && data.resources.queries) || []; searching = false; }); } else { products = []; queries = []; searching = false; }"
               class="flex-1 text-lg border-none outline-none placeholder-gray-400 bg-transparent"
               style="color: var(--color-text-primary);"
               placeholder="{{ t('pages.search.placeholder') }}"
               autocomplete="off"
               autofocus>
        <button type="button" @click="$store.modal.close()" class="p-2 rounded-full transition-colors hover:bg-gray-100">
          <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </form>

      {# Search Suggestions (queries) #}
      <div x-show="queries.length > 0" class="pt-4 pb-2">
        <p class="text-[12px] font-medium text-secondary uppercase tracking-wider mb-3">{{ t('pages.search.suggestions') | default('اقتراحات البحث') }}</p>
        <div class="flex flex-wrap gap-2">
          <template x-for="q in queries" :key="q">
            <a :href="'/shop?q=' + encodeURIComponent(q)"
               class="px-3 py-1.5 rounded-full text-[13px] text-secondary transition-all duration-200 hover:bg-accent hover:text-white"
               style="border: 1px solid var(--color-border);"
               x-text="q"></a>
          </template>
        </div>
      </div>

      {# Product Results #}
      <div x-show="products.length > 0" class="pt-4">
        <div class="flex items-center justify-between mb-4">
          <p class="text-[12px] font-medium text-secondary uppercase tracking-wider">{{ t('pages.search.products') | default('المنتجات') }}</p>
          <a :href="'/shop?q=' + encodeURIComponent(query)" class="text-[13px] font-medium text-accent hover:underline">
            {{ t('pages.search.view_all') | default('عرض الكل') }}
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <template x-for="item in products" :key="item._id">
            <a :href="'/product/' + (item.slug || item.handle)" @click="$store.modal.close()"
               class="flex gap-4 p-3 rounded-xl transition-all duration-200 hover:shadow-md group"
               style="border: 1px solid var(--color-border); background: var(--color-surface);">

              {# Product Image #}
              <div class="w-20 h-20 max-sm:w-16 max-sm:h-16 rounded-lg overflow-hidden flex-shrink-0 bg-gray-50">
                <template x-if="item.images && item.images.length">
                  <img :src="item.images[0].fileUrl" :alt="item.title"
                       class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                </template>
                <template x-if="!item.images || !item.images.length">
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-200" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                      <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </template>
              </div>

              {# Product Info #}
              <div class="flex-1 min-w-0 flex flex-col justify-center gap-1.5">
                <p class="text-[14px] font-medium text-primary line-clamp-1 group-hover:text-accent transition-colors" x-text="item.title"></p>

                <template x-if="item.description">
                  <p class="text-[12px] text-secondary line-clamp-1" x-text="item.description.replace(/<[^>]*>/g, '')"></p>
                </template>

                <div class="flex items-center gap-2">
                  <span class="text-[14px] font-bold text-accent" x-text="Qumra.utils.formatMoney(item.pricing.price)"></span>
                  <template x-if="item.pricing.compareAtPrice && item.pricing.compareAtPrice > item.pricing.price">
                    <span class="text-[12px] line-through text-tertiary" x-text="Qumra.utils.formatMoney(item.pricing.compareAtPrice)"></span>
                  </template>
                  <template x-if="item.pricing.compareAtPrice && item.pricing.compareAtPrice > item.pricing.price">
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-500 text-white"
                          x-text="'-' + Math.round(((item.pricing.compareAtPrice - item.pricing.price) / item.pricing.compareAtPrice) * 100) + '%'"></span>
                  </template>
                </div>
              </div>
            </a>
          </template>
        </div>
      </div>

      {# Loading State #}
      <div x-show="searching" x-cloak class="py-12 flex items-center justify-center">
        <svg class="w-7 h-7 animate-spin text-accent" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
        </svg>
      </div>

      {# No Results #}
      <div x-show="!searching && query.length >= 2 && products.length === 0 && queries.length === 0" class="py-12 text-center flex items-center justify-center flex-col">
        <svg class="w-12 h-12 mx-auto text-gray-200 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <p class="text-secondary text-[14px]">{{ t('pages.search.no_results') | default('لا توجد نتائج') }}</p>
      </div>

    </div>
  </div>
</div>
